# Where the web app forwards /api and /.well-known/jwks.json (read when the site is built).
# Local: the Quiz API from quizplayo-platform. On Vercel, set it per environment in Project Settings.
ISQUIZ_API_URL=http://localhost:8100

# Extra addresses live games may connect to, space-separated (only if game servers are on another domain):
ISQUIZ_CSP_CONNECT=
