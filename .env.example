# Where the web app forwards /api, /oauth2, /login/oauth2 and /logout (read when the site is built).
# Local: the Quiz API from quizplayo-platform. On Vercel, set it per environment in Project Settings.
ISQUIZ_API_URL=http://localhost:8090

# Content Security Policy (src/middleware.ts). The school portal's address, where sign-out posts a form:
ISQUIZ_IDP_ORIGIN=http://localhost:9000
# Extra addresses live games may connect to, space-separated (only if game servers are on another domain):
ISQUIZ_CSP_CONNECT=
